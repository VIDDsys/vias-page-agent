{
  "manifest_version": 3,
  "name": "Vias 页面助手",
  "version": "0.11.1",
  "minimum_chrome_version": "114",
  "description": "可靠、可确认、可中断的 AI 页面助手，支持自定义 OpenAI 兼容模型与复杂网页操作。",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Vias 页面助手（点击打开侧边栏）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
